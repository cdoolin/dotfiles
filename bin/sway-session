#!/bin/sh
set -eu

export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export XDG_SESSION_TYPE=wayland

# Console shells may not source snapd's /etc/profile.d setup.
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
case ":$XDG_DATA_DIRS:" in
    *:/var/lib/snapd/desktop:*) ;;
    *) export XDG_DATA_DIRS="$XDG_DATA_DIRS:/var/lib/snapd/desktop" ;;
esac

# Stop the broker first so it cannot reactivate backends during shutdown.
stop_portals() {
    systemctl --user stop xdg-desktop-portal.service
    systemctl --user stop \
        xdg-desktop-portal-gtk.service \
        xdg-desktop-portal-wlr.service
}
stop_portals

systemctl --user start \
    pipewire.socket \
    pipewire.service \
    pipewire-pulse.socket \
    wireplumber.service

# Return here on normal Sway exit to clean up this session's portals.
trap 'stop_portals || true' EXIT
sway "$@"
